# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# This repo is public, and .env was tracked until 2026-09-18. Anything that
# was in it before then is in the git history and must be treated as
# compromised: rotate rather than reuse. See supabase/PAYMENTS.md.

# ---- Supabase ----
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- WordPress / WooCommerce ----
# VITE_WORDPRESS_URL is the WordPress back office and serves the REST API.
# WOOCOMMERCE_STORE_URL is the public React storefront — it does NOT serve
# /wp-json, so tools that need the API should use VITE_WORDPRESS_URL.
VITE_WORDPRESS_URL=https://app.example.com/
WOOCOMMERCE_STORE_URL=https://example.com/
WOOCOMMERCE_CONSUMER_KEY=ck_...
WOOCOMMERCE_CONSUMER_SECRET=cs_...

# ---- Razorpay ----
VITE_RAZORPAY_KEY_ID=rzp_live_...
VITE_RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Cashfree ----
# CASHFREE_ENV must be "production" for live orders. It defaults to "sandbox"
# when unset, and a sandbox lookup will never find a live order.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=production

# ---- WATI (WhatsApp Team Inbox) ----
# Not wired in yet: WhatsApp currently goes out via the Meta Cloud API in
# supabase/functions/_shared/whatsapp.ts. Include the "Bearer " prefix in the
# token, as WATI's dashboard gives it.
WATI_API_ENDPOINT=https://live-mt-server.wati.io/<tenant-id>
WATI_ACCESS_TOKEN="Bearer ey..."
